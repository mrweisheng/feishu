# 飞书应用凭证(从 https://open.feishu.cn 获取)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# HTTP 服务端口
PORT=4111
# 监听网卡。默认 127.0.0.1(仅本机)。公网访问走 nginx 反代(同机转发 127.0.0.1,无需改);
# 只有绕过 nginx 直连远程访问才需要 HOST=0.0.0.0(注意:/api/messages 等其余接口无鉴权)。
HOST=127.0.0.1
# 管理页登录:预设账号 shengwei / 123456,开箱即用,无需配置。
# (仅当想换账号口令时才在 .env 覆盖 KB_ADMIN_USER / KB_ADMIN_PASSWORD)

# SQLite 数据库路径(相对 server/ 目录)
DB_PATH=./data/messages.db

# LLM(Anthropic SDK 兼容端点,指向 MiniMax;所有 LLM 调用统一用此)
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=MiniMax-M3
# LLM 单次响应 token 预算。⚠️ 不能太小:Minimax M3 是推理模型(输出混着思考块),
# 靓号工具一次要传 17 个车牌的全量 JSON,tool_use 块本身就上千 token。
# 预算太小端点会静默降级成纯文本,模型嘴上说『海报已经生成』但其实根本没调工具。
# 默认 8192 一般足够;若发现模型总是只出文本不出图,先看启动日志确认此值已生效。
LLM_MAX_TOKENS=8192

# 客资多维表格(留空 = 只入 SQLite,跳过飞书表格双写)
# 从 wiki URL 拿 app_token:  https://uipxp5adkne.feishu.cn/wiki/<NODE_TOKEN>
# 调 /open-apis/wiki/v2/spaces/get_node?token=<NODE_TOKEN> 拿 obj_token(就是 app_token)
BITABLE_CUSTOMER_APP_TOKEN=
# 调 /open-apis/bitable/v1/apps/<APP_TOKEN>/tables 拿 table_id
BITABLE_CUSTOMER_TABLE_ID=
# 表格链接(登记成功后回复里附上,用户点开直接看)
BITABLE_CUSTOMER_LINK=https://uipxp5adkne.feishu.cn/wiki/GAmHwqNGbi1ICzkAdErc9bLmnmb

# 提醒重启补偿窗口(毫秒,默认 1800000=30min):重启后过期但 < 该窗口的提醒补发,>= 的丢弃
REMINDER_RESEND_WINDOW_MS=1800000

# ---- 知识库(RAG)----
# 知识库为独立内容源:只能通过 /admin 管理页录入,与飞书消息归档、客资表无关
# 置 0 可整体关闭(不加载 sqlite-vec、不注入检索工具)
KB_ENABLED=1
# OpenAI 兼容的 /v1/embeddings 端点
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
# BAAI/bge-m3 = 1024 维固定(改不了);换模型必须同步改 DIM。
# 配错不会拒绝启动:自检失败只打印告警,并降级为纯关键词检索(FTS5),同时跳过启动对账。
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 切片:目标字符数 / 重叠字符数
KB_CHUNK_SIZE=400
KB_CHUNK_OVERLAP=60
# 嵌入并发(免费档有限流,开大只会吃 429)
KB_EMBED_CONCURRENCY=2
# 检索:向量与 BM25 各召回候选数,融合后返回条数
KB_SEARCH_CANDIDATES=20
KB_SEARCH_TOP_K=5

# ---- 每日靓号自动化 ----
# 「每日现牌输出群」chat_id:该群出现现牌文件(docx)时自动汇总各口岸出海报
# 默认已指向现牌输出群,如换群改这里;留空关闭该功能
# PLATES_SOURCE_CHAT_ID=oc_e42f9b55c0b6b78537f6a6f892fc6c11
